# Copy to .env and adjust.
PERFECTFIT_CATALOG=data/catalog/products.jsonl
PERFECTFIT_QDRANT_PATH=qdrant_db
# Any non-thinking Ollama vision model. qwen3-vl:8b-instruct is better if you have ~8 GB of VRAM.
PERFECTFIT_VLM_MODEL=qwen3-vl:4b-instruct
OLLAMA_BASE_URL=http://localhost:11434
PERFECTFIT_MAX_UPLOAD_MB=8
FLASK_DEBUG=0
