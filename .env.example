# Copy to .env and adjust.
PERFECTFIT_DATA_PATH=data/catalog
PERFECTFIT_QDRANT_PATH=qdrant_mm_db
PERFECTFIT_VLM_MODEL=llava
OLLAMA_BASE_URL=http://localhost:11434
# Optional. Without it, uploaded images are captioned by the local Ollama model.
GOOGLE_API_KEY=
PERFECTFIT_GEMINI_MODEL=gemini-2.5-flash
PERFECTFIT_MATCH_THRESHOLD=0.55
PERFECTFIT_MAX_UPLOAD_MB=8
FLASK_DEBUG=0
